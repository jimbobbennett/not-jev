{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "not-jev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "not-jev.dev",
      "custom_domain": true
    },
    {
      "pattern": "api.not-jev.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/no*",
      "/yes*",
      "/fuck-no*",
      "/magic-8-ball*"
    ]
  }
}
